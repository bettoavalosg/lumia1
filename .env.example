# Copia este archivo a .env.local para desarrollar. En Vercel se definen en Settings → Environment Variables.

# URL pública de la invitación, sin diagonal final. Hace absoluta la og:image para WhatsApp.
# En Vercel no hace falta: se toma de VERCEL_PROJECT_PRODUCTION_URL.
VITE_SITE_URL=https://ejemplo.vercel.app

# Supabase: Project Settings → API. Con las dos, la app habla con tu proyecto; SIN ellas corre en modo demo
# (el Postgres vive dentro de cada navegador: sirve para probar y ensayar, no para la fiesta de verdad).
# La anon key (eyJ…) o la publishable key (sb_publishable_…) es pública por diseño: la seguridad está en la base, no en esconderla.
# NUNCA pongas aquí la service_role key.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Notificaciones push (opcional). La pública sale de `python scripts/generar_vapid.py`. Sin ella, la app no ofrece los avisos.
VITE_VAPID_PUBLIC_KEY=
